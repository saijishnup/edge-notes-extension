{
  "manifest_version": 3,
  "name": "Quick Notes",
  "version": "2.0",
  "description": "Lightweight notes extension",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Quick Notes"
  },
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}